+package com.android.builder.model.v2.dsl
+
+import com.android.builder.model.v2.AndroidModel
+import java.io.File
+
+/** CMake configuration values, not a tool availability or installation result. */
+interface CmakeOptions : AndroidModel {
+    /** The authored version, including any trailing '+', or null when omitted. */
+    val requestedVersion: String?
+
+    /**
+     * The source-defined AGP default. A valid custom installation without an authored version
+     * is not required to match this default.
+     */
+    val defaultVersion: String
+
+    /** The explicit cmake.dir value, without checking its existence or version. */
+    val customDirectory: File?
+}
